# ==============================================================
# Fullmoon Multicuisine Family Restaurant - Environment Variables
# Copy this file to .env and replace placeholders with your actual keys
# ==============================================================

# Firebase Configuration (Create a project at https://console.firebase.google.com)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Owner Authentication
# Only this email address will be permitted access to the /owner/* dashboard
VITE_OWNER_EMAIL=owner@fullmoonrestaurant.com

# Payment Gateway (Razorpay for India - Test Mode)
# Get your test key from https://dashboard.razorpay.com/#/app/keys
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key

# Demo Mode Toggle
# When 'true' or when Firebase keys are empty, the app runs in demo/local fallback mode
# allowing full UI & Dashboard exploration without crashing.
VITE_ENABLE_MOCK_BACKEND=true

